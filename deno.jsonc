{  
  "permissions": {
    "default": {
      "read": ["./.env"],
      "env": [
        "XO_AGENT_MODEL__AGENT",
        "XO_AGENT_MODEL__JUDGE",
        "XO_AGENT_MEMORY__BREAKPOINTS",
        "LOG_LEVEL"
      ],
      "net": true,
      "sys": [
        "systemMemoryInfo"
      ],
      "run": [
        "hf",
        "mlx_lm.server"
      ],
      "write": [
        "./.output"
      ]
    }
  },
  "name": "@cutout/agent",
  "tasks": {
    "setup": "brew bundle"
  },
  "exports": {
    ".": "./app/run.ts",
    "./tools": "./libraries/tools/module.ts",
    "./tasks": "./libraries/tasks/module.ts",
    "./processes": "./libraries/processes/module.ts"
  },
  "imports": {
    "@std/cli/spinner": "jsr:@std/cli/unstable-spinner",
    "@std/streams": "jsr:@std/streams",
    "@std/dotenv": "jsr:@std/dotenv",
    "@cutout/jsx": "jsr:@cutout/jsx"
  }
}
